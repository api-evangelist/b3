                "description": "Organization ID"
              },
              {
                "name": "walletId",
                "value": "",
                "type": "path",
                "description": "Wallet ID"
              }
            ]
          },
          "docs": "Archive a wallet (soft delete). Cannot archive default wallet or only wallet."
        },
        {
          "info": {
            "name": "PUT /v1/organizations/{orgId}/wallets/{walletId}/default",
            "type": "http"
