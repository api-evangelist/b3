            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/organizations/:orgId/wallets",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization ID"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit (default 20, max 100)"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset (default 0)"
              }
            ]
          },
          "docs": "List all wallets for an organization with pagination"
        },
        {
          "info": {
            "name": "POST /v1/organizations/{orgId}/wallets",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/organizations/:orgId/wallets",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new Turnkey wallet for an organization"
        },
        {
          "info": {
            "name": "DELETE /v1/organizations/{orgId}/wallets/{walletId}",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/organizations/:orgId/wallets/:walletId",
