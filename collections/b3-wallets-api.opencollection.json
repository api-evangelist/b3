          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/organizations/:orgId/wallets/:walletId/default",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization ID"
